/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: no-cache

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/styles.css
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/app.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/tools-core.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/font-chars.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
